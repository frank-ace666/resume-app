{
  // 打包产物不进 VS Code 的文件监视器。
  // 起因：electron-builder 生成的 *.asar 被监视器长期持有句柄，
  // 导致 npm run package 在项目内直接失败（EBUSY：无法删除 app.asar）。
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/dist-*/**": true,
    "**/out/**": true
  },
  "search.exclude": {
    "**/dist/**": true,
    "**/dist-*/**": true,
    "**/out/**": true
  }
}
